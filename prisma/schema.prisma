// nobug.az — admin panel data model.
//
// Every translatable text is a Json column shaped { az: string; en?: string;
// ru?: string } (see src/lib/i18n/localized.ts). Non-translatable data (urls,
// images, numbers, order, flags) is stored once. Image columns come in pairs:
// `xUrl` is the public URL, `xPath` the Supabase Storage object path so the
// file can be deleted when the row is.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── auth (Auth.js v5, database sessions) ─────────────────────────────────

enum Role {
  ADMIN
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String
  role          Role      @default(ADMIN)
  sessions      Session[]
  accounts      Account[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Required by the Auth.js adapter contract; unused with the Credentials provider.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── content ──────────────────────────────────────────────────────────────

/// First screen of the home page. Single row, id = "singleton".
model Hero {
  id                String   @id @default("singleton")
  title             Json
  subtitle          Json
  primaryCtaLabel   Json
  primaryCtaUrl     String   @default("")
  secondaryCtaLabel Json
  secondaryCtaUrl   String   @default("")
  heroImageUrl      String?
  heroImagePath     String?
  updatedAt         DateTime @updatedAt
}

model PartnerLogo {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  logoPath  String?
  url       String   @default("")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([order])
}

/// "Nə qurduq və nəyi dəyişdi"
model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            Json
  shortDescription Json
  content          Json
  duration         String   @default("")
  year             String   @default("")
  coverUrl         String?
  coverPath        String?
  tags             Tag[]
  isFeatured       Boolean  @default(false)
  order            Int      @default(0)
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([order])
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     Json
  projects Project[]
}

/// "Bir komanda, on iki istiqamət"
model Stat {
  id        String   @id @default(cuid())
  value     String
  label     Json
  /// small print under the figure ("2026 · SLA şərtləri"); optional
  source    Json?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// "Xidmət indeksi"
model ServiceCategory {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     Json
  order    Int       @default(0)
  services Service[]

  @@index([order])
}

model Service {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             Json
  shortDescription Json
  details          Json
  icon             String           @default("")
  imageUrl         String?
  imagePath        String?
  categoryId       String?
  category         ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order            Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId, order])
}

/// "Standart göstəricilər"
model SpecGroup {
  id    String     @id @default(cuid())
  name  Json
  order Int        @default(0)
  items SpecItem[]

  @@index([order])
}

model SpecItem {
  id      String    @id @default(cuid())
  groupId String
  group   SpecGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name    Json
  value   String
  unit    String    @default("")
  order   Int       @default(0)

  @@index([groupId, order])
}

// ── leads ────────────────────────────────────────────────────────────────

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  ARCHIVED
}

/// Created only through POST /api/leads (contact form + anket).
model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String     @default("")
  phone     String     @default("")
  message   String     @default("")
  service   String     @default("")
  locale    String     @default("az")
  source    String     @default("contact")
  answers   Json?
  status    LeadStatus @default(NEW)
  notes     String     @default("")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

// ── settings ─────────────────────────────────────────────────────────────

/// Contact details, social links and footer. Single row, id = "singleton".
model SiteSettings {
  id          String       @id @default("singleton")
  phones      String[]     @default([])
  email       String       @default("")
  address     Json
  hours       Json
  linkedin    String       @default("")
  instagram   String       @default("")
  facebook    String       @default("")
  youtube     String       @default("")
  x           String       @default("")
  footerLinks FooterLink[]
  updatedAt   DateTime     @updatedAt
}

model FooterLink {
  id         String       @id @default(cuid())
  settingsId String       @default("singleton")
  settings   SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  /// footer column: services | company | legal
  group      String       @default("company")
  label      Json
  url        String
  order      Int          @default(0)

  @@index([group, order])
}
